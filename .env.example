# Local development only. Replace database credentials before deployment.
DATABASE_URL=postgresql+psycopg://dashboard:dashboard_local@127.0.0.1:5432/meta_ads
BACKEND_URL=http://127.0.0.1:8000
# Private single-owner dashboard. Run: py setup_dashboard.py (on your own machine).
# Enter the generated values only in your hosting provider's secret settings.
DASHBOARD_OWNER=
DASHBOARD_PASSWORD_HASH=
PUBLIC_ORIGIN=http://localhost:3000
DASHBOARD_LOCAL_MODE=false
AUTO_INIT_DB=true
# Separate random credential for Make -> dashboard; NOT a Meta or Telegram token.
MAKE_INGEST_TOKEN=
LIVE_AD_ACCOUNT_ID=
# true only on a separate test deployment; permanently labels received rows mock.
LIVE_DATA_TEST_MODE=false
# Server-only secrets. Never use NEXT_PUBLIC_ prefixes or paste values in chat.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v26.0
# Actual Meta expiry: ISO 8601 with offset; YYYY-MM-DD stops at START of that day in Bangkok.
# Use never only when Meta explicitly says Never; revocation checks still apply.
META_TOKEN_EXPIRES_AT=
# Explicit attribution for this report; must be confirmed before automatic operation.
# Example (not automatically assumed): 7d_click,1d_view
META_ATTRIBUTION_WINDOWS=
# Exact action_type actually configured/verified for registration; blank means unknown.
META_REGISTRATION_ACTION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=Adscopefatherbot
# All automatic operation defaults OFF. Operator confirmations are NOT Meta approval.
META_CONNECTOR_ENABLED=false
REPORTS_ENABLED=false
META_PRODUCTION_ACCESS_CONFIRMED=false
POLICY_REVIEW_CONFIRMED=false
